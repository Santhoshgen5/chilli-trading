{
  "name": "maveh-world",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MAVEH WORLD — dry red chilli export marketing site",
  "scripts": {
    "dev": "vite",
    "images": "node scripts/build-images.mjs",
    "build": "npm run images && tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:contrast": "node scripts/check-contrast.mjs",
    "audit": "node scripts/audit.mjs",
    "shot": "node scripts/shot.mjs"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.1.1",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "framer-motion": "^13.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "lighthouse": "^12.8.2",
    "postcss": "^8.4.49",
    "puppeteer-core": "^25.9.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
